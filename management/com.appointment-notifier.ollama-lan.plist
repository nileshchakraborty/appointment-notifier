<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.appointment-notifier.ollama-lan</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>lan_ip=$(/usr/sbin/ipconfig getifaddr en0); test -n "$lan_ip"; exec /usr/bin/env OLLAMA_HOST="$lan_ip:11434" /usr/local/bin/ollama serve</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/tmp/appointment-notifier-ollama.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/appointment-notifier-ollama.log</string>
</dict>
</plist>
