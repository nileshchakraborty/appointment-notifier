[Unit]
Description=Talos Protocol Telegram bot on Fedora
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/nilesh/appointment-notifier-failover
EnvironmentFile=/home/nilesh/appointment-notifier-failover/talos.env
Environment=BOT_SCOPE=talos
Environment=TALOS_BOT_TOKEN_FILE=/home/nilesh/.config/appointment-notifier-failover/talos.token
ExecStart=/home/nilesh/appointment-notifier-failover/.venv/bin/python /home/nilesh/appointment-notifier-failover/telegram-failover.py
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
