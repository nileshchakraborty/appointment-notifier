# Build OpenWA from the pinned fork revision supplied by compose.
FROM node:22-bookworm AS builder

ARG OPENWA_REPOSITORY=https://github.com/nileshchakraborty/wa-automate-nodejs.git
ARG OPENWA_COMMIT=5293a244d6303f6000f3be0ab04c62c31cb14031

ENV DEBIAN_FRONTEND=noninteractive \
    DO_NOT_TRACK=1 \
    NEXT_TELEMETRY_DISABLED=1 \
    TURBO_TELEMETRY_DISABLED=1 \
    LIGHTPANDA_EXECUTABLE_PATH=/bin/false \
    PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

RUN apt-get update \
    && apt-get install -y --no-install-recommends git python3 make g++ \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global pnpm@11.25.0

WORKDIR /src
RUN git init \
    && git remote add origin "${OPENWA_REPOSITORY}" \
    && git fetch --depth 1 origin "${OPENWA_COMMIT}" \
    && git checkout --detach FETCH_HEAD

RUN pnpm install --frozen-lockfile \
    && pnpm exec turbo build --filter='@open-wa/wa-automate...' \
    && LIGHTPANDA_EXECUTABLE_PATH=/bin/false \
       pnpm --config.inject-workspace-packages=true \
       --filter @open-wa/wa-automate deploy --prod /prod/openwa

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    IS_DOCKER=true \
    DO_NOT_TRACK=1 \
    NEXT_TELEMETRY_DISABLED=1 \
    TURBO_TELEMETRY_DISABLED=1 \
    WA_DISABLE_SPINS=true \
    WA_EXECUTABLE_PATH=/usr/bin/chromium \
    WA_USE_CHROME=true \
    PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium ca-certificates fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update \
    && apt-get install -y --no-install-recommends xvfb \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder --chown=node:node /prod/openwa ./
COPY --chown=node:node wa.config.json ./wa.config.json
COPY --chown=node:node --chmod=755 docker-entrypoint.sh /usr/local/bin/openwa-entrypoint
RUN mkdir -p /app/chrome-profile && chown -R node:node /app

USER node
EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/openwa-entrypoint"]
