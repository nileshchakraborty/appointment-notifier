# Telegram API credentials from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=.state/telegram.session
TELEGRAM_CHANNEL=@Regular_H1B_H4_VisaSlotsChecking
TELEGRAM_HISTORY_LIMIT=25

# Telegram bot alert delivery. This is separate from the Telegram channel watcher above.
TELEGRAM_ALERT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_BOT_ALLOWED_USERNAMES=
TELEGRAM_BOT_OWNER_CHAT_ID=
TELEGRAM_BOT_OWNER_USERNAMES=

# Runtime state
SQLITE_PATH=.state/appointment-notifier.sqlite3
DRY_RUN=false
LOG_LEVEL=INFO

# Historical trend analysis and chat. Statistics calculate the forecast; an LLM
# only explains those numbers. Providers are attempted in this order. Disabled
# providers are skipped.
LLM_PROVIDER_ORDER=nvidia,ollama_cloud,ollama

# NVIDIA-hosted NIM. Mount the key at NVIDIA_API_KEY_FILE; do not put it here.
NVIDIA_NIM_ENABLED=false
NVIDIA_NIM_URL=https://integrate.api.nvidia.com
NVIDIA_NIM_MODEL=openai/gpt-oss-20b
NVIDIA_API_KEY_FILE=/run/secrets/nvidia_api_key
NVIDIA_NIM_TIMEOUT_SECONDS=90
MEDIA_TEMP_DIRS=/mnt/drive1/appointment-notifier-media,/mnt/drive2/appointment-notifier-media,/tmp/appointment-notifier-media
# Private host path; keep this value only in the ignored .env file.
MEDIA_HOST_DIR=

# Direct Ollama Cloud fallback. Mount its key at OLLAMA_CLOUD_API_KEY_FILE.
OLLAMA_CLOUD_ENABLED=false
OLLAMA_CLOUD_URL=https://ollama.com
OLLAMA_CLOUD_MODEL=gpt-oss:20b
OLLAMA_CLOUD_API_KEY_FILE=/run/secrets/ollama_api_key

# Local or remote Ollama fallback. OLLAMA_URL may point to the Pi, laptop, or
# another LAN-reachable Ollama server.
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b
OLLAMA_CHAT_HISTORY_MESSAGES=8
OLLAMA_CONTEXT_TOKENS=2048
OLLAMA_RESPONSE_TOKENS=220
TREND_TIMEZONE=Asia/Kolkata

# Optional alert filtering
# Comma-separated case-insensitive terms. Empty means default H1B/H4/visa slot terms.
REQUIRED_TERMS=
# Comma-separated terms that suppress alerts even if positive terms are present.
SUPPRESS_TERMS=

# Email notifications
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_STARTTLS=true

# SMS notifications via Twilio
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_TO=

# WhatsApp notifications. Providers: twilio or openwa.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=openwa
WHATSAPP_TO=

# Self-hosted OpenWA Easy API (used when WHATSAPP_PROVIDER=openwa).
OPENWA_URL=http://openwa:8081
OPENWA_API_KEY=

# Twilio-only settings (used when WHATSAPP_PROVIDER=twilio).
# Use the Twilio sandbox sender while testing: whatsapp:+14155238886
WHATSAPP_FROM=whatsapp:+14155238886

# iMessage notifications on macOS. Requires Messages/iMessage configured locally.
IMESSAGE_ENABLED=false
IMESSAGE_TO=
